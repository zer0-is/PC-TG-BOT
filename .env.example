BOT_TOKEN=
ALLOWED_USER_IDS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free
ALLOW_SHELL=false
ALLOW_FILES=false
POWER_DELAY=25

# Подпись кнопок. Пусто — бот выведет ключ из BOT_TOKEN.
SIGNING_KEY=
# Лимит запросов в минуту на одного пользователя.
RATE_LIMIT=20
# Сколько последних действий хранить в журнале.
ACTION_LOG_LIMIT=300

# Удалённый ввод: мышь и клавиатура на ПК. Выключено по умолчанию.
ALLOW_INPUT=false
# Запись экрана и микрофона. Выключено по умолчанию.
ALLOW_AUDIO=false
# Сколько секунд писать по умолчанию (кнопки «Экран 30 с» не зависят от этого).
RECORD_SECONDS=10
